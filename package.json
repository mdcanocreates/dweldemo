{
  "name": "rbit-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:api": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "eslint .",
    "lint:boundaries": "tsx ci/gates/module-boundaries.ts",
    "ci:tenancy": "tsx ci/gates/tenancy.ts",
    "ci:pii-manifest": "tsx ci/gates/pii-manifest.ts",
    "ci:migration-safety": "tsx ci/gates/migration-safety.ts",
    "ci:openapi-drift": "tsx ci/gates/openapi-drift.ts",
    "ci:feature-leakage": "tsx ci/gates/feature-leakage.ts",
    "ci:tenant-session-local": "tsx ci/gates/tenant-session-local.ts",
    "ci:gates": "npm run lint:boundaries && npm run ci:tenancy && npm run ci:pii-manifest && npm run ci:migration-safety && npm run ci:feature-leakage && npm run ci:tenant-session-local",
    "evidence:phase0": "tsx scripts/phase0-evidence.ts",
    "seed:test-accounts": "tsx scripts/seed-test-accounts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.758.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "redis": "^4.7.1",
    "stripe": "^17.7.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testcontainers/postgresql": "^10.24.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "playwright": "^1.63.0",
    "testcontainers": "^10.24.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

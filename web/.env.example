# Local Vite → API proxy (dev/preview only; Netlify uses forNetlify _redirects)
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Netlify demo chrome (set by forNetlify build; do not enable in production CDNs)
# VITE_DWEL_NETLIFY_DEMO=true
# VITE_APP_ENV=demo

# Staging banner only when explicitly staging
# VITE_APP_ENV=staging

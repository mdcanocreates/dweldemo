VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://rbit-dev-821417220.us-east-2.elb.amazonaws.com

# Browser analytics stays off until both the flag and a phc_ project token are set,
# and the visitor grants consent. Put the token in .env.production.local, not here.
# VITE_ANALYTICS_ENABLED=false
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Map tiles stay off until a licensed style URL is set. Do not put a secret geocoding key here.
VITE_DWEL_MAP_ENABLED=false
VITE_DWEL_MAP_STYLE_URL=
# Dollar savings stay off until participating-property fees are approved.
VITE_DWEL_SAVINGS_ENABLED=false

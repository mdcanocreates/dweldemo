# Local development template. Copy to .env (gitignored).

PORT=3000
NODE_ENV=development
APP_ENV=development
# Skip AWS KMS/S3 startup probes; use LocalKmsProvider + memory object store
USE_LOCAL_INFRA=true
# Local Docker/Postgres: leave false. Staging/production RDS: true (or omit — remote host enables SSL).
DB_SSL=false
# RDS_CA_BUNDLE_PATH=/certs/rds-global-bundle.pem

AWS_REGION=us-east-2

# docker compose postgres (host 5433 if Windows Postgres already owns 5432)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=rbit_dev
DB_USER=rbit
DB_PASSWORD=rbit
DATABASE_URL=postgres://rbit:rbit@127.0.0.1:5433/rbit_dev

# Local-only — never use in production
JWT_SECRET=rbit-local-dev-jwt-not-for-prod
RBIT_AUTH_HMAC_SECRET=rbit-local-dev-auth-hmac-not-for-prod

# Not a live Stripe key — Connect uses memory adapter until sk_… is set
STRIPE_SECRET_KEY=local_dev_not_a_stripe_key
# disabled | test | live. Independent of APP_ENV. Unknown values fail closed.
# STRIPE_PAYMENT_MODE=disabled
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Live charges stay off unless this is exactly true, and this release still refuses them.
# STRIPE_LIVE_PAYMENTS_APPROVED=false
# Leave empty under USE_LOCAL_INFRA=true
S3_BUCKET=
KMS_KEY_ID=

# SES transactional email (Delivery ON only when EMAIL_PROVIDER=ses)
EMAIL_PROVIDER=ses
EMAIL_FROM_ADDRESS=noreply@rbitfinancial.com
EMAIL_REPLY_TO=info@rbitfinancial.com
# SES_CONFIGURATION_SET=rbit-transactional
# EMAIL_DELIVERY_ENABLED=0

PUBLIC_APP_URL=http://localhost:5173
AUTH_EMAIL_ALLOWLIST=info@rbitfinancial.com,mdcano@rbitfinancial.com,mdcanocreates@gmail.com,addison@rbitfinancial.com

# AUTH_RETURN_REDEEM_TOKEN=1
# Internal preview role switcher (UI-only context; never mutates party_role).
# Production: leave disabled unless explicitly enabled.
# DWEL_INTERNAL_PREVIEW_ENABLED=true
# DWEL_INTERNAL_PREVIEW_EMAILS=mdcano@rbitfinancial.com,addison@rbitfinancial.com
# Prod preview data (upsert-only, no deletes): npm run seed:preview-prod
# Plan only: npm run seed:preview-prod -- --plan-only

# Meeting demo backend path (DemoTenantScreening). Keep false unless explicitly testing demo apps.
# DWEL_DEMO_ENABLED=false

# Control Center / internal service auth (min 16 chars). Required for /internal/v1/*.
# DWEL_INTERNAL_SERVICE_TOKEN=

# Optional CC service assertion verification (JWT). When set, require X-RBIT-Service-Assertion.
# HS256 local/dev: DWEL_CC_ASSERTION_HMAC_SECRET=<min 16 chars>
# RS256 prod-style: DWEL_CC_ASSERTION_PUBLIC_KEY=<<PEM public key>>
# DWEL_CC_ASSERTION_HMAC_SECRET=
# DWEL_CC_ASSERTION_PUBLIC_KEY=

# CERTN_API_KEY=
# CERTN_WEBHOOK_SECRET=
# CERTN_BASE_URL=https://api.sandbox.certn.co
# CERTN_SANDBOX_CHECK_TYPES=IDENTITY_VERIFICATION_1

# Checkr Tenant (infrastructure enablement — admin selects default via /admin/screening)
# CHECKR_TENANT_ENABLED=false
# CHECKR_TENANT_API_URL=https://tenant.checkr.com/api
# CHECKR_TENANT_API_KEY=
# CHECKR_TENANT_WEBHOOK_SECRET=
# CHECKR_TENANT_MODE=test
# CHECKR_TENANT_API_VERSION=2026-04-29
# Live keys (ckr_sk_live_*) require APP_ENV=production AND CHECKR_TENANT_ALLOW_LIVE=true
# CHECKR_TENANT_ALLOW_LIVE=false
# Default provider for NEW orders is DB setting screening_provider_setting (disabled by default)
